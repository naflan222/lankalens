# Lanka Lens environment configuration
# Copy to .env and fill in. Never commit real credentials.

# Public site URL (used in SEO canonical / verification links)
LL_SITE_URL=http://localhost:3000

# JWT signing secret — CHANGE THIS in production
LL_JWT_SECRET=dev-only-change-me
JWT_EXPIRES_DAYS=30

# Server
PORT=3000

# Uploads
MAX_IMAGE_MB=5
MAX_IMAGES_PER_LISTING=10

# Listings
LISTINGS_REQUIRE_APPROVAL=true
LISTING_EXPIRY_DAYS=60

# SMTP email (leave SMTP_URL empty to log emails to console + dev outbox)
SMTP_URL=
MAIL_FROM="Lanka Lens <no-reply@lankalens.lk>"

# Payment provider is an abstraction and stays disabled in v1
PAYMENT_PROVIDER=none
