# Copy names into Railway Variables; never put real secrets in this file.
APP_ENV=production
DATABASE_URL=
B2_BUCKET=
B2_ENDPOINT=
B2_REGION=
B2_KEY_ID=
B2_APPLICATION_KEY=

LL_PUBLIC_URL=https://example.com
LL_CORS_ORIGINS=

# PayHere promotion checkout. Keep PAYHERE_MERCHANT_SECRET only in Railway
# Variables. Use sandbox=true while testing, then false for live payments.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
